<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Categoría y privilegio para mostrar los 3 niveles de acceso como una
         selección única en Ajustes > Usuarios, igual que hacen los módulos
         estándar de Odoo (Ventas, RRHH, etc.). -->
    <record id="module_category_police" model="ir.module.category">
        <field name="name">Policía Local</field>
        <field name="description">
            Cuadrantes, disponibilidad y servicios extraordinarios de la
            Policía Local.
        </field>
        <field name="sequence">50</field>
    </record>

    <record id="res_groups_privilege_police" model="res.groups.privilege">
        <field name="name">Policía Local</field>
        <field name="category_id" ref="module_category_police" />
        <field name="sequence">10</field>
    </record>

    <record id="group_police_extra_agent" model="res.groups">
        <field name="name">Agente (autoservicio)</field>
        <field name="privilege_id" ref="res_groups_privilege_police" />
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
        <field name="comment">
            Acceso restringido para agentes de la Policía Local: solo pueden
            ver los servicios extraordinarios publicados (o aquellos en los
            que ya están inscritos), apuntarse como voluntarios y consultar
            sus propias inscripciones y su propio cuadrante.
        </field>
    </record>

    <record id="group_police_extra_user" model="res.groups">
        <field name="name">Coordinador</field>
        <field name="privilege_id" ref="res_groups_privilege_police" />
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[(4, ref('group_police_extra_agent'))]" />
        <field name="comment">
            Gestiona el cuadrante, publica ofertas y adjudica servicios
            extraordinarios de todos los agentes.
        </field>
    </record>

    <record id="group_police_extra_manager" model="res.groups">
        <field name="name">Responsable</field>
        <field name="privilege_id" ref="res_groups_privilege_police" />
        <field name="sequence">30</field>
        <field name="implied_ids" eval="[(4, ref('group_police_extra_user'))]" />
        <field name="comment">
            Acceso completo: configuración de turnos, tarifas, restricciones
            y creación de usuarios Odoo para los agentes.
        </field>
    </record>

    <!-- Reglas de registro (ir.rule)
         Patrón estándar de Odoo: una regla restrictiva para el grupo Agente
         y una regla permisiva ([(1, '=', 1)]) para Coordinador/Responsable.
         Como estos últimos implican al grupo Agente, Odoo combina ambas
         reglas con OR y el resultado final es acceso completo para
         coordinadores y responsables, y acceso restringido solo para
         agentes puros. -->

    <record id="rule_extra_service_agent_published_or_own" model="ir.rule">
        <field
            name="name"
        >Policía: agentes solo ven servicios publicados o propios</field>
        <field name="model_id" ref="model_almonte_police_extra_service" />
        <field name="domain_force">
            ['|', ('state', '=', 'published'), '&amp;', ('state', 'in', ['assigned', 'closed']), ('signup_ids.employee_id.user_id', '=', user.id)]
        </field>
        <field name="groups" eval="[(4, ref('group_police_extra_agent'))]" />
    </record>
    <record id="rule_extra_service_coordinator_full" model="ir.rule">
        <field
            name="name"
        >Policía: coordinadores y responsables ven todos los servicios</field>
        <field name="model_id" ref="model_almonte_police_extra_service" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_police_extra_user'))]" />
    </record>

    <record id="rule_signup_agent_own" model="ir.rule">
        <field
            name="name"
        >Policía: agentes solo ven y crean sus propias inscripciones</field>
        <field name="model_id" ref="model_almonte_police_extra_service_signup" />
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_police_extra_agent'))]" />
    </record>
    <record id="rule_signup_coordinator_full" model="ir.rule">
        <field
            name="name"
        >Policía: coordinadores y responsables gestionan todas las inscripciones</field>
        <field name="model_id" ref="model_almonte_police_extra_service_signup" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_police_extra_user'))]" />
    </record>

    <record id="rule_schedule_agent_own" model="ir.rule">
        <field name="name">Policía: agentes solo ven su propio cuadrante</field>
        <field name="model_id" ref="model_almonte_police_schedule_assignment" />
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_police_extra_agent'))]" />
    </record>
    <record id="rule_schedule_coordinator_full" model="ir.rule">
        <field
            name="name"
        >Policía: coordinadores y responsables gestionan todo el cuadrante</field>
        <field name="model_id" ref="model_almonte_police_schedule_assignment" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_police_extra_user'))]" />
    </record>

    <record id="rule_history_agent_own" model="ir.rule">
        <field name="name">Policía: agentes solo ven su propio histórico</field>
        <field name="model_id" ref="model_almonte_police_extra_service_history" />
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_police_extra_agent'))]" />
    </record>
    <record id="rule_history_coordinator_full" model="ir.rule">
        <field
            name="name"
        >Policía: coordinadores y responsables ven todo el histórico</field>
        <field name="model_id" ref="model_almonte_police_extra_service_history" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_police_extra_user'))]" />
    </record>

    <record id="rule_summary_agent_own" model="ir.rule">
        <field name="name">Policía: agentes solo ven su propio resumen económico</field>
        <field name="model_id" ref="model_almonte_police_extra_summary" />
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_police_extra_agent'))]" />
    </record>
    <record id="rule_summary_coordinator_full" model="ir.rule">
        <field
            name="name"
        >Policía: coordinadores y responsables ven todo el resumen económico</field>
        <field name="model_id" ref="model_almonte_police_extra_summary" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_police_extra_user'))]" />
    </record>
    <!-- hr.employee: la regla nativa de hr (hr_employee_comp_rule) es
         principalmente multi-compañía y no restringe por usuario, así que
         añadimos nuestra propia pareja restrictiva/permisiva para que un
         agente solo vea su propia ficha y coordinadores/responsables vean
         a todos los agentes. -->
    <record id="rule_hr_employee_agent_own" model="ir.rule">
        <field name="name">Policía: agentes solo ven su propia ficha de empleado</field>
        <field name="model_id" ref="hr.model_hr_employee" />
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_police_extra_agent'))]" />
    </record>
    <record id="rule_hr_employee_coordinator_full" model="ir.rule">
        <field
            name="name"
        >Policía: coordinadores y responsables ven todos los agentes</field>
        <field name="model_id" ref="hr.model_hr_employee" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_police_extra_user'))]" />
    </record>
</odoo>
