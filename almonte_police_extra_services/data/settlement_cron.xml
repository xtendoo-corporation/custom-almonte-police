<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="ir_cron_generate_monthly_settlement" model="ir.cron">
        <field name="name">Policía Local: generar liquidación mensual de extras</field>
        <field name="model_id" ref="model_almonte_police_extra_settlement" />
        <field name="state">code</field>
        <field name="code">model._cron_generate_previous_month()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">months</field>
        <field
            name="nextcall"
            eval="(DateTime.today().replace(day=1) + relativedelta(months=1)).strftime('%Y-%m-01 03:00:00')"
        />
        <field name="active" eval="True" />
    </record>
</odoo>
