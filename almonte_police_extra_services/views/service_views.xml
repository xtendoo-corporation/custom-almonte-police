<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_service_type_list" model="ir.ui.view">
        <field name="name">almonte.police.service.type.list</field>
        <field name="model">almonte.police.service.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="code" />
                <field name="name" />
                <field name="unit_price" />
                <field name="currency_id" />
                <field name="active" />
            </list>
        </field>
    </record>
    <record id="view_service_type_form" model="ir.ui.view">
        <field name="name">almonte.police.service.type.form</field>
        <field name="model">almonte.police.service.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="code" />
                        <field name="unit_price" />
                        <field name="currency_id" />
                        <field name="active" />
                    </group>
                    <field name="notes" />
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_extra_service_list" model="ir.ui.view">
        <field name="name">almonte.police.extra.service.list</field>
        <field name="model">almonte.police.extra.service</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'assigned'">
                <field name="name" />
                <field name="service_date" />
                <field name="signup_deadline" optional="show" />
                <field
                    name="police_category_ids"
                    widget="many2many_tags"
                    optional="show"
                />
                <field name="service_type_id" />
                <field name="required_shift_id" />
                <field name="vacancies" />
                <field name="state" widget="badge" />
                <field name="total_amount" sum="Total" />
            </list>
        </field>
    </record>
    <record id="view_extra_service_form" model="ir.ui.view">
        <field name="name">almonte.police.extra.service.form</field>
        <field name="model">almonte.police.extra.service</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_publish"
                        string="Publicar"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'draft'"
                        groups="almonte_police_extra_services.group_police_extra_user"
                    />
                    <button
                        name="action_assign"
                        string="Adjudicar plazas"
                        type="object"
                        class="btn-primary"
                        invisible="state not in ('published', 'assigned')"
                        groups="almonte_police_extra_services.group_police_extra_user"
                    />
                    <button
                        name="action_reopen"
                        string="Reabrir para ampliar plazas"
                        type="object"
                        invisible="state != 'assigned'"
                        groups="almonte_police_extra_services.group_police_extra_user"
                        confirm="La oferta vuelve a publicarse. Las adjudicaciones hechas se mantienen y la lista de espera vuelve a competir por las plazas nuevas. Recuerda aumentar el número de plazas. ¿Continuar?"
                    />
                    <button
                        name="action_print_decree"
                        string="Imprimir decreto"
                        type="object"
                        icon="fa-print"
                        invisible="state not in ('assigned', 'closed')"
                        groups="almonte_police_extra_services.group_police_extra_user"
                    />
                    <button
                        name="action_volunteer"
                        string="Apuntarme como voluntario"
                        type="object"
                        class="btn-primary"
                        invisible="not can_volunteer"
                        groups="almonte_police_extra_services.group_police_extra_agent"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" /></h1>
                    </div>
                    <field name="can_volunteer" invisible="1" />
                    <group>
                        <group>
                            <field name="service_date" />
                            <field name="signup_deadline" />
                            <field name="service_type_id" />
                            <field name="required_shift_id" />
                            <field
                                name="police_category_ids"
                                widget="many2many_tags"
                                options="{'no_create': True}"
                                placeholder="Todas las categorías"
                            />
                        </group>
                        <group>
                            <field name="vacancies" />
                            <field name="hours" />
                            <field name="department" />
                            <field name="total_amount" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Inscritos">
                            <field name="signup_ids">
                                <list
                                    decoration-success="state in ('assigned_free', 'assigned_double')"
                                >
                                    <field name="row_number" />
                                    <field name="employee_id" />
                                    <field name="current_shift_id" />
                                    <field name="previous_shift_id" />
                                    <field
                                        name="priority_tier"
                                        widget="badge"
                                        decoration-success="priority_tier == '1_free'"
                                        decoration-info="priority_tier == '2_rested'"
                                        decoration-warning="priority_tier == '3_double'"
                                        decoration-danger="priority_tier in ('4_restricted', '5_unavailable')"
                                    />
                                    <field name="availability_status" />
                                    <field name="quarter_service_count" />
                                    <field name="priority_score" optional="hide" />
                                    <field name="rank" />
                                    <field name="amount" />
                                    <field name="state" widget="badge" />
                                    <button
                                        name="action_open_employee_schedule"
                                        string="Ver cuadrante"
                                        type="object"
                                        icon="fa-calendar"
                                        class="btn-link"
                                    />
                                </list>
                            </field>
                        </page>
                        <page string="Observaciones">
                            <field name="notes" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_extra_service_search" model="ir.ui.view">
        <field name="name">almonte.police.extra.service.search</field>
        <field name="model">almonte.police.extra.service</field>
        <field name="arch" type="xml">
            <search string="Buscar servicios extraordinarios">
                <field name="name" string="Nº oferta" />
                <field name="service_date" string="Fecha" />
                <field name="service_type_id" string="Tipo de servicio" />
                <field name="required_shift_id" string="Turno" />
                <field name="state" string="Estado" />
                <separator />
                <filter
                    name="published"
                    string="Publicadas"
                    domain="[('state', '=', 'published')]"
                />
                <filter
                    name="assigned"
                    string="Adjudicadas"
                    domain="[('state', '=', 'assigned')]"
                />
            </search>
        </field>
    </record>
    <record id="view_history_list" model="ir.ui.view">
        <field name="name">almonte.police.extra.service.history.list</field>
        <field name="model">almonte.police.extra.service.history</field>
        <field name="arch" type="xml">
            <list decoration-info="origin == 'backlog'">
                <field name="service_date" />
                <field name="employee_id" />
                <field name="origin" widget="badge" optional="show" />
                <field name="service_id" />
                <field name="service_type_id" />
                <field name="days" sum="Total días" />
                <field name="hours" />
                <field name="amount" sum="Total" />
                <field name="currency_id" column_invisible="1" />
            </list>
        </field>
    </record>
    <record id="view_history_backlog_list" model="ir.ui.view">
        <field name="name">almonte.police.extra.service.history.backlog.list</field>
        <field name="model">almonte.police.extra.service.history</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="origin" column_invisible="1" />
                <field name="service_date" string="Fecha de referencia" />
                <field name="employee_id" options="{'no_create': True}" />
                <field name="days" string="Días extras atrasados" sum="Total días" />
                <field name="amount" string="Cuantía" sum="Total" />
                <field name="currency_id" column_invisible="1" />
                <field name="notes" />
            </list>
        </field>
    </record>
    <record id="view_history_search" model="ir.ui.view">
        <field name="name">almonte.police.extra.service.history.search</field>
        <field name="model">almonte.police.extra.service.history</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id" />
                <field name="service_id" />
                <filter
                    name="backlog"
                    string="Extras atrasados"
                    domain="[('origin', '=', 'backlog')]"
                />
                <filter
                    name="assigned_services"
                    string="Servicios adjudicados"
                    domain="[('origin', '=', 'service')]"
                />
                <group>
                    <filter
                        name="group_employee"
                        string="Agente"
                        context="{'group_by': 'employee_id'}"
                    />
                    <filter
                        name="group_origin"
                        string="Origen"
                        context="{'group_by': 'origin'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <record id="view_extra_service_list_agent" model="ir.ui.view">
        <field name="name">almonte.police.extra.service.list.agent</field>
        <field name="model">almonte.police.extra.service</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'assigned'" create="0" delete="0">
                <field name="name" />
                <field name="service_date" />
                <field name="signup_deadline" />
                <field name="police_category_ids" widget="many2many_tags" />
                <field name="service_type_id" />
                <field name="required_shift_id" />
                <field name="vacancies" />
                <field name="state" widget="badge" />
                <button
                    name="action_volunteer"
                    string="Apuntarme"
                    type="object"
                    icon="fa-hand-paper-o"
                    invisible="not can_volunteer"
                    class="btn-link"
                />
            </list>
        </field>
    </record>

    <record id="view_extra_service_form_agent" model="ir.ui.view">
        <field name="name">almonte.police.extra.service.form.agent</field>
        <field name="model">almonte.police.extra.service</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button
                        name="action_volunteer"
                        string="Apuntarme"
                        type="object"
                        class="btn-primary"
                        invisible="not can_volunteer"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="service_date" />
                            <field name="signup_deadline" />
                            <field name="required_shift_id" />
                        </group>
                        <group>
                            <field name="service_type_id" />
                            <field name="vacancies" />
                            <field
                                name="police_category_ids"
                                widget="many2many_tags"
                                placeholder="Todas las categorías"
                            />
                            <field name="can_volunteer" invisible="1" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Policías apuntados y adjudicación">
                            <field name="signup_ids" readonly="1">
                                <list
                                    decoration-success="state in ('assigned_free', 'assigned_double')"
                                    decoration-muted="state in ('waiting_free', 'waiting_double')"
                                    default_order="rank, row_number"
                                >
                                    <field name="rank" />
                                    <field name="employee_id" />
                                    <field name="row_number" string="Orden inscripción" />
                                    <field
                                        name="priority_tier"
                                        widget="badge"
                                        decoration-success="priority_tier == '1_free'"
                                        decoration-info="priority_tier == '2_rested'"
                                        decoration-warning="priority_tier == '3_double'"
                                        decoration-danger="priority_tier in ('4_restricted', '5_unavailable')"
                                    />
                                    <field name="state" widget="badge" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_extra_service_search_agent" model="ir.ui.view">
        <field name="name">almonte.police.extra.service.search.agent</field>
        <field name="model">almonte.police.extra.service</field>
        <field name="arch" type="xml">
            <search string="Servicios extraordinarios disponibles">
                <field name="name" string="Nº oferta" />
                <field name="service_date" string="Fecha" />
                <field name="service_type_id" string="Tipo de servicio" />
                <field name="required_shift_id" string="Turno" />
                <filter
                    name="published"
                    string="Publicadas"
                    domain="[('state', '=', 'published')]"
                />
                <filter
                    name="assigned"
                    string="Adjudicadas"
                    domain="[('state', 'in', ('assigned', 'closed'))]"
                />
                <filter
                    name="my_services"
                    string="Donde estoy apuntado"
                    domain="[('signup_ids.employee_id.user_id', '=', uid)]"
                />
            </search>
        </field>
    </record>

    <record id="view_signup_list_my" model="ir.ui.view">
        <field name="name">almonte.police.extra.service.signup.list.my</field>
        <field name="model">almonte.police.extra.service.signup</field>
        <field name="arch" type="xml">
            <list
                decoration-success="state in ('assigned_free', 'assigned_double')"
                decoration-muted="state in ('waiting_free', 'waiting_double')"
                create="0"
                edit="0"
            >
                <field name="service_id" />
                <field name="availability_status" />
                <field name="rank" />
                <field name="amount" />
                <field name="state" widget="badge" />
                <button
                    name="action_withdraw"
                    string="Retirar"
                    type="object"
                    icon="fa-times"
                    invisible="state in ('assigned_free', 'assigned_double', 'waiting_free', 'waiting_double')"
                    class="btn-link"
                    confirm="¿Seguro que quieres retirar tu inscripción?"
                />
            </list>
        </field>
    </record>
</odoo>
