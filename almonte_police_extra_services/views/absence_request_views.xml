<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_absence_request_list" model="ir.ui.view">
        <field name="name">almonte.police.absence.request.list</field>
        <field name="model">almonte.police.absence.request</field>
        <field name="arch" type="xml">
            <list
                decoration-info="state == 'pending'"
                decoration-success="state == 'approved'"
                decoration-danger="state == 'refused'"
                decoration-muted="state == 'cancelled'"
            >
                <field name="employee_id" />
                <field name="shift_type_id" />
                <field name="date_from" />
                <field name="date_to" />
                <field name="day_count" />
                <field name="reason" optional="hide" />
                <field
                    name="state"
                    widget="badge"
                    decoration-info="state == 'pending'"
                    decoration-success="state == 'approved'"
                    decoration-danger="state == 'refused'"
                />
            </list>
        </field>
    </record>
    <record id="view_absence_request_form" model="ir.ui.view">
        <field name="name">almonte.police.absence.request.form</field>
        <field name="model">almonte.police.absence.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_approve"
                        string="Aprobar"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'pending'"
                        groups="almonte_police_extra_services.group_police_extra_user"
                        confirm="Se escribirá el estado en el cuadrante del agente para todos los días del periodo. ¿Continuar?"
                    />
                    <button
                        name="action_refuse"
                        string="Rechazar"
                        type="object"
                        invisible="state != 'pending'"
                        groups="almonte_police_extra_services.group_police_extra_user"
                    />
                    <button
                        name="action_cancel"
                        string="Cancelar solicitud"
                        type="object"
                        invisible="state != 'pending' or not id"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="pending,approved"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field
                                name="employee_id"
                                readonly="id"
                                options="{'no_create': True, 'no_open': True}"
                            />
                            <field
                                name="shift_type_id"
                                readonly="state != 'pending'"
                                options="{'no_create': True, 'no_open': True}"
                            />
                        </group>
                        <group>
                            <field name="date_from" readonly="state != 'pending'" />
                            <field name="date_to" readonly="state != 'pending'" />
                            <field name="day_count" />
                        </group>
                    </group>
                    <field
                        name="reason"
                        placeholder="Motivo o información para el responsable..."
                        readonly="state != 'pending'"
                    />
                    <group>
                        <field
                            name="response"
                            readonly="state != 'pending'"
                            placeholder="Respuesta del responsable al resolver..."
                        />
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>
    <record id="view_absence_request_search" model="ir.ui.view">
        <field name="name">almonte.police.absence.request.search</field>
        <field name="model">almonte.police.absence.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id" />
                <field name="shift_type_id" />
                <filter
                    name="pending"
                    string="Pendientes"
                    domain="[('state', '=', 'pending')]"
                />
                <filter
                    name="approved"
                    string="Aprobadas"
                    domain="[('state', '=', 'approved')]"
                />
                <separator />
                <filter name="filter_date_from" string="Fecha" date="date_from" />
                <group>
                    <filter
                        name="group_employee"
                        string="Agente"
                        context="{'group_by': 'employee_id'}"
                    />
                    <filter
                        name="group_state"
                        string="Estado"
                        context="{'group_by': 'state'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <record id="action_my_absence_requests" model="ir.actions.act_window">
        <field name="name">Mis solicitudes de ausencia</field>
        <field name="res_model">almonte.police.absence.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('employee_id.user_id', '=', uid)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Solicita vacaciones, asuntos propios u otros permisos
            </p>
            <p>
                La solicitud queda pendiente hasta que un responsable la apruebe;
                entonces se refleja en tu cuadrante.
            </p>
        </field>
    </record>
    <record id="action_absence_requests" model="ir.actions.act_window">
        <field name="name">Solicitudes de ausencia</field>
        <field name="res_model">almonte.police.absence.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending': 1}</field>
    </record>
</odoo>
