<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_employee_form_police" model="ir.ui.view">
        <field name="name">hr.employee.form.almonte.police</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='employee_properties']" position="before">
                <group name="police_info" string="Policía Local">
                    <group name="police_info_organization">
                        <field
                            name="police_category_id"
                            options="{'no_create': True}"
                            placeholder="Selecciona la categoría del agente"
                        />
                        <field
                            name="police_group_id"
                            options="{'no_create': True}"
                            placeholder="Selecciona el grupo del agente"
                        />
                    </group>
                    <group name="police_info_identification">
                        <field name="police_dip" placeholder="Nº de DIP" />
                        <field name="police_employee_id" />
                    </group>
                </group>
            </xpath>
            <xpath expr="//sheet" position="before">
                <div
                    class="alert alert-info"
                    role="alert"
                    invisible="not police_category_id or user_id"
                    groups="almonte_police_extra_services.group_police_extra_manager"
                >
                    Este agente todavía no tiene un usuario Odoo. Puedes
                    crearle uno (su login será el DIP) para que acceda al
                    autoservicio de la Policía Local.
                    <button
                        name="action_create_police_user"
                        string="Crear usuario Odoo"
                        type="object"
                        class="btn-link"
                    />
                </div>
                <div
                    class="alert alert-secondary"
                    role="alert"
                    invisible="not police_category_id or not user_id"
                    groups="almonte_police_extra_services.group_police_extra_manager"
                >
                    El agente accede con su DIP. Si ha olvidado la contraseña,
                    genera una nueva clave temporal y entrégasela.
                    <button
                        name="action_regenerate_police_password"
                        string="Regenerar contraseña"
                        type="object"
                        class="btn-link"
                        confirm="Se generará una nueva contraseña y la actual dejará de funcionar. ¿Continuar?"
                    />
                </div>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page
                    name="police_schedule"
                    string="Cuadrante"
                    invisible="not police_category_id"
                >
                    <field name="police_schedule_assignment_ids">
                        <list editable="bottom" default_order="date">
                            <field name="date" />
                            <field name="shift_type_id" />
                            <field name="notes" />
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
