<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_priority_criterion_list" model="ir.ui.view">
        <field name="name">almonte.police.priority.criterion.list</field>
        <field name="model">almonte.police.priority.criterion</field>
        <field name="arch" type="xml">
            <list editable="bottom" decoration-muted="not enabled">
                <field name="sequence" widget="handle" />
                <field name="kind" />
                <field name="criterion_type" />
                <field name="explanation" />
                <field name="enabled" widget="boolean_toggle" />
                <field name="service_type_id" column_invisible="True" />
            </list>
        </field>
    </record>
    <record id="view_priority_criterion_search" model="ir.ui.view">
        <field name="name">almonte.police.priority.criterion.search</field>
        <field name="model">almonte.police.priority.criterion</field>
        <field name="arch" type="xml">
            <search>
                <field name="criterion_type" />
                <filter name="enabled" string="Activos" domain="[('enabled', '=', True)]" />
                <group>
                    <filter name="group_kind" string="Tipo" context="{'group_by': 'kind'}" />
                </group>
            </search>
        </field>
    </record>
    <record id="action_priority_criteria" model="ir.actions.act_window">
        <field name="name">Criterios de prelación</field>
        <field name="res_model">almonte.police.priority.criterion</field>
        <field name="view_mode">list</field>
        <field name="domain">[('service_type_id', '=', False)]</field>
        <field name="context">{'search_default_group_kind': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define cómo se adjudican los servicios extraordinarios.
            </p>
            <p>
                Las <strong>exclusiones</strong> impiden adjudicar el servicio a un
                agente. Los criterios de <strong>orden</strong> se aplican de arriba
                abajo: el primero decide y los siguientes desempatan. Arrastra para
                cambiar el orden y desactiva los que no quieras aplicar.
            </p>
            <p>
                Cada tipo de servicio puede tener su propio orden desde
                Configuración → Tipos de servicio y tarifas.
            </p>
        </field>
    </record>
</odoo>
