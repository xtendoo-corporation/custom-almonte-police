<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="action_schedule" model="ir.actions.act_window">
        <field name="name">Cuadrante</field>
        <field name="res_model">almonte.police.schedule.assignment</field>
        <field name="view_mode">calendar,list</field>
        <field
            name="view_id"
            ref="almonte_police_extra_services.view_schedule_assignment_calendar"
        />
        <field
            name="search_view_id"
            ref="almonte_police_extra_services.view_schedule_assignment_search"
        />
    </record>
    <record id="action_schedule_calendar_view" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">calendar</field>
        <field
            name="view_id"
            ref="almonte_police_extra_services.view_schedule_assignment_calendar"
        />
        <field name="act_window_id" ref="almonte_police_extra_services.action_schedule" />
    </record>
    <record id="action_schedule_list_view" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">list</field>
        <field
            name="view_id"
            ref="almonte_police_extra_services.view_schedule_assignment_list"
        />
        <field name="act_window_id" ref="almonte_police_extra_services.action_schedule" />
    </record>
    <record id="action_police_employees" model="ir.actions.act_window">
        <field name="name">Agentes</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('police_category_id', '!=', False)]</field>
    </record>
    <record id="action_extra_services" model="ir.actions.act_window">
        <field name="name">Servicios extraordinarios</field>
        <field name="res_model">almonte.police.extra.service</field>
        <field name="view_mode">list,form</field>
        <field
            name="view_id"
            ref="almonte_police_extra_services.view_extra_service_list"
        />
        <field
            name="search_view_id"
            ref="almonte_police_extra_services.view_extra_service_search"
        />
    </record>
    <record id="action_extra_services_list_view" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field
            name="view_id"
            ref="almonte_police_extra_services.view_extra_service_list"
        />
        <field
            name="act_window_id"
            ref="almonte_police_extra_services.action_extra_services"
        />
    </record>
    <record id="action_extra_services_form_view" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">form</field>
        <field
            name="view_id"
            ref="almonte_police_extra_services.view_extra_service_form"
        />
        <field
            name="act_window_id"
            ref="almonte_police_extra_services.action_extra_services"
        />
    </record>
    <record id="action_history" model="ir.actions.act_window">
        <field name="name">Histórico de extras</field>
        <field name="res_model">almonte.police.extra.service.history</field>
        <field name="view_mode">list</field>
    </record>
    <record id="action_history_backlog" model="ir.actions.act_window">
        <field name="name">Extras atrasados</field>
        <field name="res_model">almonte.police.extra.service.history</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_history_backlog_list" />
        <field name="domain">[('origin', '=', 'backlog')]</field>
        <field name="context">{'default_origin': 'backlog'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Registra los días de servicios extraordinarios atrasados
            </p>
            <p>
                Cada día atrasado computa como un servicio para el orden de
                adjudicación y su cuantía se suma a la liquidación del mes de
                la fecha de referencia.
            </p>
        </field>
    </record>
    <record id="action_service_types" model="ir.actions.act_window">
        <field name="name">Tipos de servicio y tarifas</field>
        <field name="res_model">almonte.police.service.type</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_shift_types" model="ir.actions.act_window">
        <field name="name">Tipos de turno</field>
        <field name="res_model">almonte.police.shift.type</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_restrictions" model="ir.actions.act_window">
        <field name="name">Restricciones entre turnos</field>
        <field name="res_model">almonte.police.shift.restriction</field>
        <field name="view_mode">list</field>
    </record>
    <record id="action_extra_summary" model="ir.actions.act_window">
        <field name="name">Resumen económico por policía</field>
        <field name="res_model">almonte.police.extra.summary</field>
        <field name="view_mode">list,pivot</field>
    </record>
    <record id="action_working_schedules" model="ir.actions.act_window">
        <field name="name">Calendarios laborales</field>
        <field name="res_model">resource.calendar</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="resource.view_resource_calendar_tree" />
        <field name="search_view_id" ref="resource.view_resource_calendar_search" />
        <field
            name="domain"
        >['|', ('company_id', '=', False), ('company_id', 'in', allowed_company_ids)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configura aquí los horarios laborales de referencia.
            </p>
            <p>
                El cuadrante policial diario del módulo se gestiona desde
                <strong>Cuadrante</strong>, no desde estos calendarios estándar.
            </p>
        </field>
    </record>
    <record id="action_extra_services_available" model="ir.actions.act_window">
        <field name="name">Servicios disponibles</field>
        <field name="res_model">almonte.police.extra.service</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_extra_service_list_agent" />
        <field name="search_view_id" ref="view_extra_service_search_agent" />
        <field name="domain">[('state', '=', 'published')]</field>
        <field name="context">{'search_default_published': 1}</field>
    </record>
    <record
        id="action_extra_services_available_list_view"
        model="ir.actions.act_window.view"
    >
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_extra_service_list_agent" />
        <field name="act_window_id" ref="action_extra_services_available" />
    </record>
    <record
        id="action_extra_services_available_form_view"
        model="ir.actions.act_window.view"
    >
        <field name="sequence">2</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_extra_service_form_agent" />
        <field name="act_window_id" ref="action_extra_services_available" />
    </record>
    <record id="action_extra_services_assignments" model="ir.actions.act_window">
        <field name="name">Adjudicaciones</field>
        <field name="res_model">almonte.police.extra.service</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_extra_service_search_agent" />
        <field name="domain">[('state', 'in', ('published', 'assigned', 'closed'))]</field>
        <field name="context">{'search_default_assigned': 1}</field>
    </record>
    <record
        id="action_extra_services_assignments_list_view"
        model="ir.actions.act_window.view"
    >
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_extra_service_list_agent" />
        <field name="act_window_id" ref="action_extra_services_assignments" />
    </record>
    <record
        id="action_extra_services_assignments_form_view"
        model="ir.actions.act_window.view"
    >
        <field name="sequence">2</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_extra_service_form_agent" />
        <field name="act_window_id" ref="action_extra_services_assignments" />
    </record>
    <record id="action_my_schedule" model="ir.actions.act_window">
        <field name="name">Mi cuadrante</field>
        <field name="res_model">almonte.police.schedule.assignment</field>
        <field name="view_mode">calendar,list</field>
        <field name="domain">[('employee_id.user_id', '=', uid)]</field>
        <field name="context">{'show_shift_hours': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Todavía no tienes turnos asignados en el cuadrante.
            </p>
            <p>
                Cualquier permiso reglamentario o baja excluye de realizar
                servicios extraordinarios en ese día.
            </p>
        </field>
    </record>
    <record id="action_my_schedule_calendar_view" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">calendar</field>
        <field name="view_id" ref="view_schedule_assignment_calendar_agent" />
        <field name="act_window_id" ref="action_my_schedule" />
    </record>
    <record id="action_my_schedule_list_view" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_schedule_assignment_list_agent" />
        <field name="act_window_id" ref="action_my_schedule" />
    </record>
    <record id="action_my_signups" model="ir.actions.act_window">
        <field name="name">Mis inscripciones</field>
        <field name="res_model">almonte.police.extra.service.signup</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_signup_list_my" />
        <field name="domain">[('employee_id.user_id', '=', uid)]</field>
    </record>
